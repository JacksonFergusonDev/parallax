---
/**
 * The primary download: the newest release's universal disk image, read from
 * GitHub at build time (src/lib/releases.ts). Before the first release it
 * points to the releases page instead.
 */
import Icon from 'house-style/astro/Icon.astro';
import { formatSize, getReleases, latest } from '../lib/releases';
import { links } from '../lib/site';

interface Props {
  /** Show the link to every version; off on the page that lists them. */
  versions?: boolean;
}
const { versions = true } = Astro.props;
const release = latest(await getReleases());
---

<div class="download">
  <div class="actions">
    {release?.dmg ? (
      <a class="hs-button hs-button--primary" href={release.dmg.url} data-download>
        Download for Mac
      </a>
    ) : (
      <a class="hs-button hs-button--primary" href={links.releases}>
        Follow releases on GitHub <Icon name="arrow-up-right" size={16} />
      </a>
    )}
    {versions && (
      <a class="text-link" href={links.download}>
        All versions <Icon name="arrow-right" size={16} />
      </a>
    )}
  </div>
  <p class="download-meta">
    {release?.dmg
      ? `Version ${release.version} · ${formatSize(release.dmg.size)} · Apple silicon and Intel`
      : 'The first release is on its way. Apple silicon and Intel Macs.'}
  </p>
</div>
