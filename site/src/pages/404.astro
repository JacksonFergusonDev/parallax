---
import Icon from 'house-style/astro/Icon.astro';
import StarField from '../components/StarField.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="hs-hero" aria-labelledby="missing-title">
    <StarField />
    <h1 id="missing-title">Nothing at this point of view.</h1>
    <p class="lede">This page doesn't exist. The link may be old, or the address mistyped.</p>
    <div class="actions">
      <a class="hs-button hs-button--primary" href="/">
        Back to Parallax <Icon name="arrow-left" size={16} />
      </a>
    </div>
  </section>
</Base>
