---
import Icon from 'house-style/astro/Icon.astro';
import SectionMarker from 'house-style/astro/SectionMarker.astro';
import { marked } from 'marked';
import DownloadButton from '../components/DownloadButton.astro';
import Base from '../layouts/Base.astro';
import { formatDate, formatSize, getReleases, latest } from '../lib/releases';
import { links, notarized } from '../lib/site';

const releases = await getReleases();
const newest = latest(releases);
const cliTargets = [
  ['aarch64-apple-darwin', 'CLI, Apple silicon'],
  ['x86_64-apple-darwin', 'CLI, Intel'],
] as const;
---

<Base
  title="Download"
  description="Download Parallax for Mac, and every earlier version with its release notes."
>
  <section class="hs-hero" aria-labelledby="download-title">
    <h1 id="download-title">Download Parallax.</h1>
    <p class="lede">
      One app for Apple silicon and Intel Macs. Once installed, Parallax checks for new versions
      itself and installs one only when you say so.
    </p>
    <DownloadButton versions={false} />
  </section>

  {!notarized && (
    <section id="first-open" class="hs-grid section" aria-labelledby="first-open-title">
      <SectionMarker number={1} label="First open" />
      <h2 id="first-open-title">Allow Parallax once, the first time you open it.</h2>
      <p class="section-lede">
        Parallax isn't notarized by Apple yet, so macOS can't check it and blocks it the first time.
        You confirm it once in System Settings. Updates install without asking again.
      </p>
      <ol class="steps">
        <li>
          <h3>Install it</h3>
          <p>Open the downloaded disk image and drag Parallax into Applications.</p>
        </li>
        <li>
          <h3>Try to open it</h3>
          <p>
            Open Parallax from Applications. macOS says it couldn't verify it. Choose{' '}
            <strong>Done</strong>, not Move to Trash.
          </p>
        </li>
        <li>
          <h3>Allow it in System Settings</h3>
          <p>
            Open <strong>System Settings › Privacy &amp; Security</strong>, scroll to Security, and
            choose <strong>Open Anyway</strong> next to the message about Parallax.
          </p>
        </li>
        <li>
          <h3>Open it</h3>
          <p>
            Choose <strong>Open Anyway</strong> again and enter your password or use Touch ID. From
            then on Parallax opens like any other app.
          </p>
        </li>
      </ol>
    </section>
  )}

  <section id="versions" class="hs-grid section" aria-labelledby="versions-title">
    <SectionMarker number={notarized ? 1 : 2} label="Versions" />
    <h2 id="versions-title">Every release, with what changed.</h2>
    {releases.length === 0 ? (
      <p class="section-lede">
        No version has been released yet. Watch the repository on GitHub to hear when the first one
        is out.
      </p>
    ) : (
      <ol class="versions">
        {releases.map((r) => (
          <li id={r.tag}>
            <div class="version-head">
              <h3>
                {r.name}
                {r === newest && <span class="version-tag">Latest</span>}
                {r.prerelease && <span class="version-tag">Pre-release</span>}
              </h3>
              <time class="version-date" datetime={r.date.toISOString()}>
                {formatDate(r.date)}
              </time>
            </div>
            {r.notes && <div class="notes" set:html={marked.parse(r.notes, { async: false })} />}
            <ul class="version-files">
              {r.dmg && (
                <li>
                  <a class="text-link" href={r.dmg.url}>
                    Mac app ({formatSize(r.dmg.size)})
                  </a>
                </li>
              )}
              {cliTargets.map(
                ([target, label]) =>
                  r.cli[target] && (
                    <li>
                      <a class="text-link" href={r.cli[target].url}>
                        {label} ({formatSize(r.cli[target].size)})
                      </a>
                    </li>
                  ),
              )}
              <li>
                <a class="text-link" href={r.page}>
                  On GitHub <Icon name="arrow-up-right" size={16} />
                </a>
              </li>
            </ul>
          </li>
        ))}
      </ol>
    )}
    <p class="note">
      <a class="text-link" href={links.releases}>
        All releases on GitHub <Icon name="arrow-up-right" size={16} />
      </a>
    </p>
  </section>
</Base>
