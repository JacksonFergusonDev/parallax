{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parallax",
  "version": "0.1.1",
  "identifier": "dev.parallax.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Parallax",
        "visible": false,
        "width": 1280,
        "height": 900,
        "center": true,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' asset: http://asset.localhost data: blob: https://*.mzstatic.com https://covers.openlibrary.org https://*.archive.org https://archive.org https://books.google.com https://books.googleusercontent.com; font-src 'self' blob: data:; media-src 'self' blob:; frame-src blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/library/books/**",
          "$APPCACHE/device-covers/**",
          "$APPCACHE/upscale-previews/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Jackson Ferguson",
    "category": "Productivity",
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kepubify"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 196
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 196
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QTRGMzFDNjg4N0FFN0IKUldSN3JvZG9IUE9rR1ZGMmcxSDhVSXNIL0VlbFB3Z0ZvL3lkS3Q5WmNPd2JJN1pKdUE3SmtHUE0K",
      "endpoints": [
        "https://github.com/JacksonFergusonDev/parallax/releases/latest/download/latest.json"
      ]
    }
  }
}
