{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-Reader Companion",
  "version": "0.1.0",
  "identifier": "dev.erc.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "E-Reader Companion",
        "visible": false,
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https://*.mzstatic.com https://covers.openlibrary.org https://*.archive.org https://archive.org https://books.google.com https://books.googleusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/library/books/**",
          "$APPCACHE/device-covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kepubify"
    ]
  }
}
